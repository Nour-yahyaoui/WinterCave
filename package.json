{
  "name": "wintercave",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "WinterCave \u2014 a latency-obsessed text editor with a platform-neutral core",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node --experimental-strip-types server/index.ts",
    "serve": "npm run build && node --experimental-strip-types server/index.ts --port 4173 --dist dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "wasm:build": "node scripts/build-wasm.mjs",
    "wasm:smoke": "node scripts/wasm-smoke.mjs",
    "serve:rust": "cargo run --quiet -p wintercave-server --",
    "smoke:rust": "node scripts/actix-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
